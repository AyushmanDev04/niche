# Copy to .env and fill in. NEVER commit the real .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Required — the app refuses to start without these.
JWT_SECRET_KEY=
SECRET_KEY=

# Database. Omit for local SQLite (sqlite:///data.db).
DATABASE_URL=postgresql://postgres:password@db:5432/myapp

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5000

# Optional: Google sign-in. The client ID is public; there is no secret here
# because the frontend uses the ID-token flow.
GOOGLE_CLIENT_ID=

# Optional: created/promoted by `flask bootstrap-admin`.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: share rate-limit counters across gunicorn workers.
# Without this each worker counts separately, multiplying every limit.
# RATELIMIT_STORAGE_URI=redis://localhost:6379
